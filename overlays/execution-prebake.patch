+def _h3_prebake_inactive_headroom(prompt, registered_nodes, active_headroom, inactive_headroom):
+    """Let the existing Adaptive hook budget H3 before TE loads in formal PreBake.
+
+    Outputs retain their normal cache ownership. Real RAM pressure can still evict
+    them; no ModelPatcher is pinned or moved into an external retention registry.
+    """
+    if not 6 * (1024 ** 3) <= active_headroom <= inactive_headroom:
+        return inactive_headroom
+    official = registered_nodes.get("MiniMaxH3ReferenceToVideo")
+    if (getattr(official, "_H3_ADAPTIVE_HOST_WARM_PATCHED", False) is not True
+            or getattr(official, "_H3_ADAPTIVE_HOST_WARM_PATCH_INSTALL_COUNT", 0) != 1
+            or not callable(getattr(official, "_H3_ADAPTIVE_HOST_WARM_ORIGINAL_EXECUTE", None))):
+        return inactive_headroom
+    allowed = {"MiniMaxH3ReferenceToVideo", "CLIPLoader", "VAELoader",
+               "Any Switch (rgthree)", "ResolutionSelector", "PrimitiveFloat",
+               "PrimitiveInt", "PrimitiveBoolean", "PrimitiveStringMultiline",
+               "ComfyMathExpression", "LoadImageCrop", "LoadImage",
+               "H3ConditioningBake", "H3SelectiveTEUnload"}
+    if (not prompt or any(n.get("class_type") not in allowed for n in prompt.values())
+            or prompt.get("136", {}).get("class_type") != "MiniMaxH3ReferenceToVideo"):
+        return inactive_headroom
+    bakes = [n for n in prompt.values() if n.get("class_type") == "H3ConditioningBake"]
+    if len(bakes) != 1:
+        return inactive_headroom
+    bake = bakes[0].get("inputs", {})
+    te_link = bake.get("conditioning")
+    if (bake.get("require_te_released") is not True or bake.get("latent") != ["136", 1]
+            or not isinstance(te_link, list) or len(te_link) != 2 or te_link[1] != 0):
+        return inactive_headroom
+    te = prompt.get(te_link[0], {})
+    if (te.get("class_type") != "H3SelectiveTEUnload"
+            or te.get("inputs", {}).get("conditioning") != ["136", 0]):
+        return inactive_headroom
+    return active_headroom
+
+
+def _h3_prebake_release_before_te(prompt_id):
+    # Reuse the installed Adaptive ownership checks and RAM/Commit budget.
+    # No new model owner or pin is introduced here.
+    from pathlib import Path
+    expected = Path(__file__).resolve().parent / "custom_nodes/h3_adaptive_host_warm_inplace/__init__.py"
+    matches = [m for m in tuple(sys.modules.values())
+               if getattr(m, "__file__", None)
+               and Path(m.__file__).resolve() == expected]
+    if len(matches) != 1 or not callable(getattr(matches[0], "release_exact", None)):
+        raise RuntimeError("Pre-TE Adaptive safety module unavailable; TE blocked")
+    record = {"prompt_id": prompt_id, "node_id": "128", "status": "FAIL_CLOSED",
+              "handoff": "BEFORE_TE_LOADER128"}
+    matches[0].write(dict(record), "PRE_TE_LOADER_ENTER")
+    try:
+        matches[0].release_exact(record)
+    except Exception as ex:
+        matches[0].write({**record, "error": str(ex)}, "PRE_TE_FAIL_CLOSED")
+        raise
 
 
